{
  "name": "join",
  "version": "0.1.0",
  "homepage": "https://artir97.github.io/join-with-react",
  "private": true,
  "dependencies": {
    "firebase": "^12.12.0",
    "react": "^18",
    "react-dom": "^18",
    "react-router-dom": "^6.27.0",
    "react-scripts": "5.0.1",
    "react-svg": "^16.1.34",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "npx @tailwindcss/cli -i src/input.css -o public/output.css --minify & react-scripts start",
    "build": "npx @tailwindcss/cli -i src/input.css -o public/output.css --minify & react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "gh-pages": "^6.2.0",
    "tailwindcss": "^4.2.2"
  }
}
